{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "paths": {
      "../ThemeStore": ["./stores/ThemeStore.tsx"],
      "../FileStore": ["./stores/FileStore.tsx"],
      "../WorkflowEventBus": ["./components/WorkflowEventBus.tsx"],
      "../SettingsBridge": ["./services/SettingsBridge.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": ["node_modules", "coverage", "dist", "examples"]
}
