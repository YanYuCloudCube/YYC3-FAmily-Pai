{
  "name": "@yyc3/effects",
  "version": "1.0.0",
  "description": "YYC³ UI 特效组件库 — 赛博朋克 / 液态玻璃 / 3D / 粒子 / 视差 / 微交互",
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test && pnpm typecheck"
  },
  "keywords": [
    "yyc3",
    "effects",
    "cyberpunk",
    "liquid-glass",
    "neon",
    "glitch",
    "particle",
    "3d",
    "parallax",
    "motion",
    "react",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YanYuCloudCube/FAmily-pi3.git",
    "directory": "packages/effects"
  },
  "homepage": "https://github.com/YanYuCloudCube/FAmily-pi3#readme",
  "bugs": {
    "url": "https://github.com/YanYuCloudCube/FAmily-pi3/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.58.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^24.0.0"
  }
}
