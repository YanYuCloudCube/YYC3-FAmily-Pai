{
  "name": "@yyc3/mcp-servers",
  "version": "3.0.0",
  "description": "YYC³ AI Family MCP Server 集合 — 8个即插即用的 Model Context Protocol Server",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test && pnpm typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "yyc3",
    "ai-family",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-tools",
    "agent-tools",
    "typescript"
  ],
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanYuCloudCube/YYC3-FAmily-Pai",
    "directory": "packages/mcp-servers"
  },
  "homepage": "https://github.com/YanYuCloudCube/YYC3-FAmily-Pai#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    }
  ]
}
