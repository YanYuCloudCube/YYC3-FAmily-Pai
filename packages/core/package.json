{
  "name": "@yyc3/core",
  "version": "1.4.0",
  "description": "YYC³ AI Family 核心包 — 统一认证、MCP协议、技能系统、八位AI家人智能体、多模态处理",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./ai-family": {
      "types": "./dist/ai-family/index.d.ts",
      "import": "./dist/ai-family/index.js"
    },
    "./multimodal": {
      "types": "./dist/multimodal/index.d.ts",
      "import": "./dist/multimodal/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test && pnpm typecheck"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "yyc3",
    "family-pai",
    "ai",
    "mcp",
    "model-context-protocol",
    "openai",
    "ollama",
    "anthropic",
    "claude",
    "ai-agent",
    "multimodal",
    "speech-to-text",
    "text-to-speech",
    "image-analysis",
    "document-processing",
    "typescript"
  ],
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanYuCloudCube/YYC3-FAmily-Pai.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/YanYuCloudCube/YYC3-FAmily-Pai/issues"
  },
  "homepage": "https://github.com/YanYuCloudCube/YYC3-FAmily-Pai#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    }
  ]
}
